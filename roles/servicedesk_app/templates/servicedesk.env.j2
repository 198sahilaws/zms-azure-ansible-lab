# {{ ansible_managed }}
#
# Read by systemd (EnvironmentFile) and, on the middleware tier, by the
# bootstrap and seed commands. Mode 0640 root:{{ sd_app_group_name }}.
#
# Rendered from sd_app_environment, which is sd_env_common combined with either
# sd_env_middleware or sd_env_web (see roles/servicedesk_app/defaults/main.yml).
# Nothing is written here that is not in that dict, so the environment the
# service runs with and the environment the seeder ran with cannot drift apart.
# To add a setting, add it there — editing this template alone gives the unit a
# variable the seed step does not have.
#
# TIER: {{ sd_tier }}
{% if sd_tier == 'web' %}
#
# This host holds NO database credentials. SD_DB_PASSWORD is absent, not empty.
# The web tier reaches data only through SD_MIDDLEWARE_URL below.
{% endif %}
{% for key, value in sd_app_environment | dictsort %}
{{ key }}={{ value }}
{% endfor %}
