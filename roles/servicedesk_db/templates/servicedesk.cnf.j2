# {{ ansible_managed }}
#
# Drop-in for the ZMS lab service desk. Kept separate from the distro's own
# my.cnf so a package upgrade cannot silently revert it.
#
# Deployed as {{ sd_db_dropin_name }} — see roles/servicedesk_db/defaults/main.yml.
# The filename is part of the fix, not cosmetic: `!includedir` reads *.cnf in
# ASCII order and the last assignment wins, and Ubuntu's mysqld.cnf sits in the
# same directory setting bind-address = 127.0.0.1. A numeric prefix loses to it.
[mysqld]
# THE SINGLE MOST COMMON LAB FAILURE. MySQL on Ubuntu listens only on 127.0.0.1
# out of the box, so the middleware host gets "Can't connect to MySQL server" that
# looks exactly like an NSG or routing problem and is neither.
bind-address = 0.0.0.0
port = {{ sd_db_port }}

# THE SECOND MOST COMMON. Without this, every connection from the middleware
# triggers a reverse DNS lookup that may have no answer in the VNet, so connects take
# seconds and time out under load. Grants must then be by IP pattern, which is
# what '{{ sd_db_user }}'@'{{ sd_db_client_pattern }}' already is.
skip-name-resolve = 1

# The app opens a connection per request on purpose (see sdapp/db.py) — that is
# what makes each request a distinct flow rather than one long-lived socket a
# microsegmentation agent sees once. Connection churn needs headroom.
max_connections = 300
