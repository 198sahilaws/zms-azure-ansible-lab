# {{ ansible_managed }}
[Unit]
Description=ZMS lab microservice: {{ zms_service_name }} (port {{ zms_service_spec.port }})
Documentation=file://{{ zms_app_root }}/src/zmsapp/{{ zms_service_name }}.py
# network-online, not just network: gunicorn binds 0.0.0.0 and the service
# immediately talks to another host, so a half-configured interface at boot is
# a real failure mode on a cloud VM.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ zms_app_user }}
Group={{ zms_app_group }}
WorkingDirectory={{ zms_app_root }}/src
EnvironmentFile={{ zms_app_config_dir }}/{{ zms_service_name }}.env
ExecStart={{ zms_app_root }}/venv/bin/gunicorn \
    --workers {{ zms_app_workers }} \
    --bind 0.0.0.0:{{ zms_service_spec.port }} \
    --timeout 30 \
    --graceful-timeout 10 \
    --access-logfile - \
    --error-logfile - \
    --access-logformat '%({X-Forwarded-For}i)s %(h)s "%(r)s" %(s)s %(M)sms' \
    zmsapp.wsgi:app

# Restart always, with a delay. This is what makes "stop a service and watch
# the storefront degrade" a deliberate demo rather than an accident: you have
# to stop the unit, not kill the process, because a kill just comes back.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zms-{{ zms_service_name }}

# Lab-grade hardening: enough to be a good example, not so much that it fights
# a mixed estate. NoNewPrivileges and PrivateTmp cost nothing anywhere;
# ProtectSystem=full keeps /usr and /etc read-only for this unit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
