# {{ ansible_managed }}
# Environment for zms-{{ zms_service_name }}.service on {{ inventory_hostname }}.
#
# Generated from vars/zms-app.yml. Every address below was resolved at converge
# time from the azure_rm dynamic inventory, so replacing a VM and running
# the playbook again rewrites this file with the new private IPs. Nothing here
# is hand-maintained.
#
# Values are shell-quoted (the quote filter): systemd's EnvironmentFile parser
# strips quotes and backslashes from unquoted values, so a database password
# containing ' " \ or a space would reach the service altered while the seeder
# (raw value via Ansible's environment:) used the real one. Quoted, it arrives
# byte for byte; plain values stay unquoted.

# --- identity --------------------------------------------------------------
ZMS_SERVICE={{ zms_service_name | quote }}
ZMS_VERSION={{ zms_app_version | quote }}
ZMS_PORT={{ zms_service_spec.port | quote }}
ZMS_NODE_IP={{ ansible_facts['default_ipv4']['address'] | default(inventory_hostname) | quote }}
ZMS_DISTRO={{ (ansible_facts['distribution'] ~ ' ' ~ ansible_facts['distribution_version']) | quote }}

{% if zms_service_has_db | bool %}
# --- database (this service's own schema, on its own server) ---------------
ZMS_DB_HOST={{ zms_db_host | quote }}
ZMS_DB_PORT=3306
ZMS_DB_NAME={{ zms_service_spec.db_name | quote }}
ZMS_DB_USER={{ zms_app_db_user | quote }}
ZMS_DB_PASSWORD={{ zms_app_db_password | quote }}
ZMS_DB_DISTRO={{ zms_service_spec.db_distro_group | replace('distro_', '') | quote }}
{% else %}
# This service owns no database. There are deliberately no DB_* values here:
# the storefront could not reach a schema even if it wanted to.
{% endif %}

# --- peer endpoints --------------------------------------------------------
# Every host gets the full map whether it uses it or not, so a service can be
# moved between hosts without editing anything but vars/zms-app.yml.
#
# Ring-scoped via zms_ring_peers, and this is the file where it matters most: it
# is what one service uses to call another. Without the intersect, an estate
# holding two copies of the topology would give every copy the same peer URLs
# and two thirds of the calls would cross a fence the ring NSGs drop.
{% for name, spec in zms_app_services.items() %}
{% set peer = (groups[zms_app_web_group] | default([]) | intersect(groups[spec.app_distro_group] | default([])) | intersect(zms_ring_peers)) | first | default('') %}
{% if peer %}
ZMS_{{ name | upper }}_URL={{ ('http://' ~ peer ~ ':' ~ spec.port) | quote }}
{% else %}
# ZMS_{{ name | upper }}_URL unresolved: no host in {{ zms_app_web_group }} and {{ spec.app_distro_group }}{{ (' within ' ~ zms_ring_group) if zms_ring_group | default('', true) | length > 0 else '' }}
# ^ the ring suffix above is an inline EXPRESSION on purpose. The template
# module runs Jinja with trim_blocks on, so an if/endif block tag placed at the
# end of a content line swallows that line's newline — the next loop
# iteration's ZMS_*_URL= would then be appended to this comment and silently
# commented out. Conditionals that sit mid-line must be expressions.
{% endif %}
{% endfor %}

# Short on purpose. A slow dependency must degrade a page, not hang it.
ZMS_HTTP_TIMEOUT=2.5

# --- fake data -------------------------------------------------------------
ZMS_SEED_PRODUCTS={{ zms_app_seed_products | quote }}
ZMS_SEED_ORDERS={{ zms_app_seed_orders | quote }}
ZMS_SEED_RANDOM={{ zms_app_seed_random_seed | quote }}

PYTHONPATH={{ (zms_app_root ~ '/src') | quote }}
PYTHONUNBUFFERED=1
