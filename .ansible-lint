---
profile: production
exclude_paths:
  - collections/
  - .github/
  - .cache/

skip_list:
  # Role variables here are deliberately NOT prefixed with the role name.
  # vars/servicedesk.yml is the single source of truth for the Service Desk
  # topology and is loaded by several playbooks that hand the same values to
  # the servicedesk_* roles. Prefixing would mean duplicating every value per
  # role, which defeats the point of one map. The rest of var-naming (invalid
  # characters, Python keywords, shadowed facts) still applies -- only the
  # role-prefix sub-rule is skipped.
  - var-naming[no-role-prefix]
