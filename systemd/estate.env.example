# /etc/ansible/estate.env — Contract 3 between Terraform and this repo.
#
# Terraform writes this file at control-node build time (modules/ansible-control
# cloud-init), 0640 root:root, and the systemd units load it with
# EnvironmentFile=. Do not edit it on a Terraform-built node; this example is
# for a hand-built control node or a workstation. Values below are
# illustrative. It names the vault and secret but holds no secret material.
AZURE_LOCATION=centralindia
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Client ID of the control node's user-assigned managed identity.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
ANSIBLE_AZURE_AUTH_SOURCE=msi
# The estate's resource group. The scripts copy it into
# ANSIBLE_AZURE_VM_RESOURCE_GROUPS, which scopes the azure_rm inventory.
ANSIBLE_RESOURCE_GROUP=zms-webapp-rg-ab12c
ANSIBLE_KEYVAULT_NAME=kvzmswebappab12c
ANSIBLE_SECRET_NAME=zms-webapp-ansible-credentials-ab12c
# The Environment tag value; an extra filter inside the resource group.
ANSIBLE_ESTATE=webapp
CONTROL_REPO_DIR=/opt/control-repo
# Optional, read by scripts/notify-result.sh:
# ANSIBLE_LOG_DIR=/var/log/ansible
# Optional, read by scripts/converge.sh and reconverge.sh: an alternative path
# to this file for manual runs.
# ANSIBLE_ESTATE_ENV=/etc/ansible/estate.env
